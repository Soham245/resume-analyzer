+    'github': 'GitHub', 'gitlab': 'GitLab', 'bitbucket': 'Bitbucket',
+    'github actions': 'GitHub Actions', 'gitlab ci': 'GitLab CI',
+    'graphql': 'GraphQL',
+    'restful': 'REST APIs', 'rest api': 'REST API', 'rest apis': 'REST APIs',
+    'aws': 'AWS', 'gcp': 'GCP', 'azure': 'Azure',
