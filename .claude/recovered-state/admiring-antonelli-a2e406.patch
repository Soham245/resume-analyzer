+// ── Skill display casing ─────────────────────────────────────────────────
+// The backend / AI sometimes returns skills lower-cased ("firebase", "flask").
+// Apply a brand-name lookup first, then fall back to capitalising the first
+// letter of each word. Covers technical skills, soft skills, languages, and
+// project tech_stack lists — used at every data-ingress point so chips AND
+// the rendered resume preview/PDF stay consistent.
+const SKILL_BRAND_CASE = {
+    'javascript': 'JavaScript', 'typescript': 'TypeScript',
+    'nodejs': 'Node.js', 'node.js': 'Node.js', 'node': 'Node.js',
+    'reactjs': 'React', 'react.js': 'React', 'react': 'React',
+    'react native': 'React Native',
