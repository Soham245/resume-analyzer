+    'machine learning': 'Machine Learning', 'deep learning': 'Deep Learning',
+    'api': 'API', 'apis': 'APIs',
+    'ui': 'UI', 'ux': 'UX', 'ui/ux': 'UI/UX',
+    'ios': 'iOS', 'macos': 'macOS', 'os': 'OS',
+    'oop': 'OOP', 'oops': 'OOP',
+    'devops': 'DevOps', 'devsecops': 'DevSecOps',
+    'json': 'JSON', 'xml': 'XML', 'yaml': 'YAML', 'csv': 'CSV',
+    'tcp/ip': 'TCP/IP', 'http': 'HTTP', 'https': 'HTTPS',
+    'jwt': 'JWT', 'oauth': 'OAuth', 'oauth2': 'OAuth2',
+    'pwa': 'PWA', 'spa': 'SPA', 'ssr': 'SSR',
+    'wcag': 'WCAG', 'seo': 'SEO',
+    'c++': 'C++', 'c#': 'C#', 'objective-c': 'Objective-C',
+    'matlab': 'MATLAB',
+    'aws lambda': 'AWS Lambda', 'aws s3': 'AWS S3', 'aws ec2': 'AWS EC2',
+};
+
+function formatSkillLabel(skill) {
+    if (skill == null) return skill;
+    const trimmed = String(skill).trim();
+    if (!trimmed) return trimmed;
+    const lower = trimmed.toLowerCase();
+    if (SKILL_BRAND_CASE[lower]) return SKILL_BRAND_CASE[lower];
+    // If the value already has any uppercase letter, assume the source cased
+    // it deliberately and leave it alone (e.g. "FastAPI" returned by backend).
+    if (trimmed !== lower) return trimmed;
+    // All-lowercase fallback: capitalise the first letter of every word.
+    return lower.replace(/(^|[\s\-/])([a-z])/g, (_, sep, ch) => sep + ch.toUpperCase());
+}
+
+function formatSkillList(arr) {
+    if (!Array.isArray(arr)) return arr;
+    const seen = new Set();
+    const out = [];
+    for (const item of arr) {
+        const formatted = formatSkillLabel(item);
+        if (!formatted) continue;
+        const key = formatted.toLowerCase();
+        if (seen.has(key)) continue;
+        seen.add(key);
+        out.push(formatted);
+    }
+    return out;
+}
+
+function normalizeSkillCasing(data) {
+    if (!data || typeof data !== 'object') return data;
+    if (Array.isArray(data.technical_skills)) data.technical_skills = formatSkillList(data.technical_skills);
+    if (Array.isArray(data.soft_skills))      data.soft_skills      = formatSkillList(data.soft_skills);
+    if (Array.isArray(data.languages))        data.languages        = formatSkillList(data.languages);
+    if (data.skill_groups && typeof data.skill_groups === 'object') {
+        for (const k of Object.keys(data.skill_groups)) {
+            if (Array.isArray(data.skill_groups[k])) {
+                data.skill_groups[k] = formatSkillList(data.skill_groups[k]);
+            }
+        }
+    }
+    if (Array.isArray(data.projects)) {
+        for (const p of data.projects) {
+            if (p && Array.isArray(p.tech_stack)) p.tech_stack = formatSkillList(p.tech_stack);
+        }
+    }
+    return data;
+}
+
+function normalizeSkillBuckets(buckets) {
+    if (!buckets || typeof buckets !== 'object') return buckets;
+    return {
+        technical: formatSkillList(buckets.technical || []),
+        soft:      formatSkillList(buckets.soft || []),
+        languages: formatSkillList(buckets.languages || []),
+    };
+}
