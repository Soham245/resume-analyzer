{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Flask Backend (API)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "backend.app"],
      "port": 5000
    },
    {
      "name": "Frontend (Static Server)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "frontend"],
      "port": 8080
    }
  ]
}
